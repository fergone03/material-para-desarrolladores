# API REST (PostgREST) de consultorialocal.es/material-para-desarrolladores
# Escucha en 127.0.0.1:3000; nginx lo expone en /material-para-desarrolladores/api/rest/v1/.
[Unit]
Description=PostgREST - API de material-para-desarrolladores
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
ExecStart=/opt/material-para-desarrolladores/bin/postgrest /etc/material-para-desarrolladores/postgrest.conf
ExecReload=/bin/kill -s USR2 $MAINPID
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
